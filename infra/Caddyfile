# Jawdi reverse proxy — automatic HTTPS (Let's Encrypt).
# Two sites on one box:
#   {$DOMAIN}, www.{$DOMAIN}  -> landing (Astro vitrine)
#   app.{$DOMAIN}            -> web (Next.js dashboard) + backend (/api, actuator…)
#   partner.{$DOMAIN}        -> same web container, partner portal (/portal) + backend
#   admin.{$DOMAIN}          -> same web container, platform back-office (/console) + backend
#   jaeger.{$DOMAIN}         -> Jaeger UI (distributed tracing), behind a password
#
# Requires public DNS A/AAAA for all six names -> this VPS, ports 80/443 open.
# If Cloudflare is in front, use DNS-only (grey cloud) for the first certs,
# then optionally enable the orange-cloud proxy (Full/strict). See DEPLOY.md.

# --- Shared snippets ---

# Hold a request for up to 60 s while the upstream is not accepting connections (container
# restarting during a deploy) instead of answering 502 at once. Only dial failures are retried, so
# a request that reached the app is never replayed.
(retry_upstream) {
	lb_try_duration 60s
	lb_try_interval 500ms
}

# HSTS lives here and only here: TLS terminates at Caddy. `header` SETS (replaces) a field, so a
# value coming from an upstream (nginx, Next.js) never ends up duplicated.
(base_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# App sites add a Content-Security-Policy in REPORT-ONLY mode: Next.js needs inline scripts and
# styles and the policy could not be validated against every screen from here. It blocks nothing;
# watch the browser console, tighten, then rename the header to Content-Security-Policy.
(app_headers) {
	import base_headers
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
}

# --- Marketing vitrine (root + www) ---
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip
	import base_headers
	reverse_proxy landing:80 {
		import retry_upstream
	}
}

# --- App: dashboard + API, on the app subdomain ---
app.{$DOMAIN} {
	encode zstd gzip
	import app_headers

	# Backend : API REST et actuator. Ni le contrat OpenAPI ni la console Swagger ne sont
	# routés ici : ils cartographient toutes les routes et « Try it out » écrit en base.
	# Ils vivent sur l'hôte du back-office, derrière un mot de passe (voir plus bas).
	@backend path /api/* /actuator/*
	handle @backend {
		reverse_proxy backend:8080 {
			import retry_upstream
		}
	}

	# Everything else -> Next.js web app.
	handle {
		reverse_proxy web:3000 {
			import retry_upstream
		}
	}
}

# --- Partner portal (B2), same web + backend containers, own subdomain ---
partner.{$DOMAIN} {
	encode zstd gzip
	import app_headers

	# Backend : API REST et actuator. Ni le contrat OpenAPI ni la console Swagger ne sont
	# routés ici : ils cartographient toutes les routes et « Try it out » écrit en base.
	# Ils vivent sur l'hôte du back-office, derrière un mot de passe (voir plus bas).
	@backend path /api/* /actuator/*
	handle @backend {
		reverse_proxy backend:8080 {
			import retry_upstream
		}
	}

	# Everything else -> Next.js web app (the (partner) route group serves /portal).
	handle {
		reverse_proxy web:3000 {
			import retry_upstream
		}
	}
}

# --- Platform back-office (super-admin console), same containers, own subdomain ---
# The Next middleware 404s /console/** on any other host, so the console is not even
# discoverable from the farmer app or the partner portal.
admin.{$DOMAIN} {
	encode zstd gzip
	import app_headers

	# Contrat OpenAPI et console Swagger : ici et nulle part ailleurs, et jamais sans mot de passe.
	#
	# Un sous-domaine est une adresse, pas une serrure — la même raison qui vaut pour Jaeger plus
	# bas. Ce qui est en jeu est plus gros ici : la page liste toutes les routes et sait les
	# appeler, sur la base de production.
	#
	# Le hash bcrypt vient de l'environnement, jamais de ce fichier :
	#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<mot de passe>'
	# docker-compose.prod.yml refuse de démarrer si SWAGGER_UI_PASSWORD_HASH manque, donc un
	# déploiement sans mot de passe échoue au lieu d'ouvrir la page.
	#
	# Trois chemins, parce que la console est servie en trois morceaux : /swagger est l'adresse
	# que l'on tape, /swagger-ui/* porte les fichiers vers lesquels elle redirige, et
	# /v3/api-docs est le contrat que la page télécharge ensuite. En protéger deux sur trois ne
	# protège rien.
	@swagger path /swagger /swagger/* /swagger-ui* /v3/api-docs*
	handle @swagger {
		basic_auth {
			{$SWAGGER_UI_USER} {$SWAGGER_UI_PASSWORD_HASH}
		}

		# L'adresse demandée (/swagger/index.html) mène au même endroit que /swagger.
		rewrite /swagger/index.html /swagger-ui/index.html

		reverse_proxy backend:8080 {
			import retry_upstream
		}
	}

	# Backend : API REST et actuator. Ni le contrat OpenAPI ni la console Swagger ne sont
	# routés ici : ils cartographient toutes les routes et « Try it out » écrit en base.
	# Ils vivent sur l'hôte du back-office, derrière un mot de passe (voir plus bas).
	@backend path /api/* /actuator/*
	handle @backend {
		reverse_proxy backend:8080 {
			import retry_upstream
		}
	}

	# Everything else -> Next.js web app (the (admin) route group serves /console).
	handle {
		reverse_proxy web:3000 {
			import retry_upstream
		}
	}
}

# --- Tracing (Jaeger), on its own subdomain ---
# Jaeger's UI has NO authentication of its own. Served bare, it would hand anyone who guesses
# the name the API surface, the farm ids and the shape of the database. A subdomain is an
# address, not a lock.
#
# The password is a bcrypt hash injected from the environment, never in this file:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
jaeger.{$DOMAIN} {
	encode zstd gzip
	import base_headers

	basic_auth {
		{$JAEGER_UI_USER} {$JAEGER_UI_PASSWORD_HASH}
	}

	reverse_proxy jaeger:16686
}
