# Jawdi reverse proxy — automatic HTTPS (Let's Encrypt).
# Two sites on one box:
#   {$DOMAIN}, www.{$DOMAIN}  -> landing (Astro vitrine)
#   app.{$DOMAIN}            -> web (Next.js dashboard) + backend (/api, actuator…)
#   partner.{$DOMAIN}        -> same web container, partner portal (/portal) + backend
#   admin.{$DOMAIN}          -> same web container, platform back-office (/console) + backend
#   jaeger.{$DOMAIN}         -> Jaeger UI (distributed tracing), behind a password
#
# Requires public DNS A/AAAA for all six names -> this VPS, ports 80/443 open.
# If Cloudflare is in front, use DNS-only (grey cloud) for the first certs,
# then optionally enable the orange-cloud proxy (Full/strict). See DEPLOY.md.

# --- Marketing vitrine (root + www) ---
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy landing:80
}

# --- App: dashboard + API, on the app subdomain ---
app.{$DOMAIN} {
	encode zstd gzip

	# Backend: REST API, actuator, OpenAPI/Swagger.
	@backend path /api/* /actuator/* /v3/api-docs* /swagger-ui*
	handle @backend {
		reverse_proxy backend:8080
	}

	# Everything else -> Next.js web app.
	handle {
		reverse_proxy web:3000
	}
}

# --- Partner portal (B2), same web + backend containers, own subdomain ---
partner.{$DOMAIN} {
	encode zstd gzip

	# Backend: REST API, actuator, OpenAPI/Swagger.
	@backend path /api/* /actuator/* /v3/api-docs* /swagger-ui*
	handle @backend {
		reverse_proxy backend:8080
	}

	# Everything else -> Next.js web app (the (partner) route group serves /portal).
	handle {
		reverse_proxy web:3000
	}
}

# --- Platform back-office (super-admin console), same containers, own subdomain ---
# The Next middleware 404s /console/** on any other host, so the console is not even
# discoverable from the farmer app or the partner portal.
admin.{$DOMAIN} {
	encode zstd gzip

	# Backend: REST API, actuator, OpenAPI/Swagger.
	@backend path /api/* /actuator/* /v3/api-docs* /swagger-ui*
	handle @backend {
		reverse_proxy backend:8080
	}

	# Everything else -> Next.js web app (the (admin) route group serves /console).
	handle {
		reverse_proxy web:3000
	}
}

# --- Tracing (Jaeger), on its own subdomain ---
# Jaeger's UI has NO authentication of its own. Served bare, it would hand anyone who guesses
# the name the API surface, the farm ids and the shape of the database. A subdomain is an
# address, not a lock.
#
# The password is a bcrypt hash injected from the environment, never in this file:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
jaeger.{$DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$JAEGER_UI_USER} {$JAEGER_UI_PASSWORD_HASH}
	}

	reverse_proxy jaeger:16686
}
