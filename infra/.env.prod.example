# Copy to infra/.env on the VPS and fill in real values. NEVER commit the filled .env.
# JWT RSA keys are NOT here (they are multiline) — put them in
# infra/secrets/jwt_private.pem and infra/secrets/jwt_public.pem; deploy.sh injects them.

# Root domain (DNS must point A records for the apex, www AND app to this VPS).
# Caddy serves: {DOMAIN} + www.{DOMAIN} -> landing, app.{DOMAIN} -> web + API.
DOMAIN=jawdi.app

# PostgreSQL (internal to the compose network).
DB_NAME=avicare
DB_USER=avicare
DB_PASSWORD=CHANGE_ME_use_a_long_random_password

# JWT issuer (keys live in infra/secrets/*.pem).
JWT_ISSUER=avicare-platform

# Back-office (admin.DOMAIN). The account with this email is promoted to platform staff at every
# startup and granted every permission. It must ALREADY be signed up — the app never creates it.
# Leave empty and nobody can enter the console: that is the safe default, not a bug.
ADMIN_FOUNDER_EMAIL=

# Numéro d'astreinte : le tien. Reçoit les alertes urgentes de la plateforme — module coupé par le
# kill switch, incohérence de données CRITICAL, tentative d'intrusion bloquée. Laissé vide, ces
# alertes sont écrites dans le journal d'audit et n'atteignent PERSONNE ; le backend le dit dans un
# WARN au démarrage et l'écran Pilotage affiche « astreinte : absente ».
# Format international sans « + » ni espaces, ex. 221701234567.
ADMIN_ONCALL_PHONE=

# Contact de secours : quelqu'un d'AUTRE que toi. Prévenu si tu n'as pas été vu sur la console
# depuis 72 h, pour qu'une plateforme tenue par une seule personne ne reste pas sans surveillance
# en cas d'accident. Lis docs/continuity/ avant de le renseigner : le numéro est la partie facile,
# briefer la personne est la partie qui compte.
ADMIN_EMERGENCY_PHONE=

# WhatsApp via Konekt. Powers the self-service password reset and the partner network alerts.
# Left disabled, the reset screen behaves normally but no code is ever delivered — so turn it on
# before telling farmers the feature exists.
NOTIF_WHATSAPP_ENABLED=false
KONEKT_API_SECRET=

# Container images on GHCR. Replace OWNER with your GitHub org/user (lowercase).
# The CI deploy overrides the tag with the commit SHA; :latest is the fallback.
BACKEND_IMAGE=ghcr.io/abdoumalickcisse3/avicare-backend:latest
WEB_IMAGE=ghcr.io/abdoumalickcisse3/avicare-web:latest
LANDING_IMAGE=ghcr.io/abdoumalickcisse3/avicare-landing:latest

# Backend JVM memory cap (fits alongside PG/Redis/web/caddy on an 8 GB box).
BACKEND_MEM=3g

# Jawdi IA — real Anthropic LLM. Leave disabled to run the offline keyword Mock.
# To turn it on: set ANTHROPIC_ENABLED=true and paste a valid Anthropic key, then redeploy.
# NEVER commit the filled .env. Rotate the key if it was ever exposed.
ANTHROPIC_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: offsite backup destination for backup-db.sh (an rclone remote:path).
# BACKUP_REMOTE=backup:avicare-db

# --- Traçage distribué (Jaeger) ---
# Vider TRACING_JAVA_OPTS désactive l'agent sans reconstruire l'image ; OTEL_SDK_DISABLED=true
# fait la même chose côté SDK. Le backend fonctionne dans les deux cas : l'exportateur échoue
# en silence quand personne n'écoute.
TRACING_JAVA_OPTS=-javaagent:/opt/otel/opentelemetry-javaagent.jar
# Part du trafic normal tracée. Monter temporairement pour traquer un problème précis, puis
# redescendre : le mobile interroge l'API en boucle. Les erreurs restent dans request_traces.
OTEL_SAMPLE_RATIO=0.05
OTEL_SDK_DISABLED=false
JAEGER_MEM=512m
# Interface Jaeger, sur jaeger.<DOMAIN>. OBLIGATOIRE : sans le hachage, le déploiement échoue
# plutôt que de publier une interface sans mot de passe.
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'votre-mot-de-passe'
JAEGER_UI_USER=admin
JAEGER_UI_PASSWORD_HASH=
