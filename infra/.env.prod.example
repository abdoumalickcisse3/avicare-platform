# Copy to infra/.env on the VPS and fill in real values. NEVER commit the filled .env.
# JWT RSA keys are NOT here (they are multiline) — put them in
# infra/secrets/jwt_private.pem and infra/secrets/jwt_public.pem; deploy.sh injects them.

# Root domain (DNS must point A records for the apex, www AND app to this VPS).
# Caddy serves: {DOMAIN} + www.{DOMAIN} -> landing, app.{DOMAIN} -> web + API.
DOMAIN=jawdi.com

# PostgreSQL (internal to the compose network).
DB_NAME=avicare
DB_USER=avicare
DB_PASSWORD=CHANGE_ME_use_a_long_random_password

# JWT issuer (keys live in infra/secrets/*.pem).
JWT_ISSUER=avicare-platform

# Container images on GHCR. Replace OWNER with your GitHub org/user (lowercase).
# The CI deploy overrides the tag with the commit SHA; :latest is the fallback.
BACKEND_IMAGE=ghcr.io/OWNER/avicare-backend:latest
WEB_IMAGE=ghcr.io/OWNER/avicare-web:latest
LANDING_IMAGE=ghcr.io/OWNER/avicare-landing:latest

# Backend JVM memory cap (fits alongside PG/Redis/web/caddy on an 8 GB box).
BACKEND_MEM=3g

# Optional: offsite backup destination for backup-db.sh (an rclone remote:path).
# BACKUP_REMOTE=backup:avicare-db
