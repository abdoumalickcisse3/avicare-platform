# Copy to .env.local and adjust for your machine. .env.local is gitignored.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Dev-only: disable subscription feature gating in the UI (auto-pick a full
# bundle, skip the signup plan step, hide the trial nudge). Mirrors the backend
# avicare.features.gating-enabled=false. Leave UNSET in production. See ADR-004.
# NEXT_PUBLIC_FEATURES_GATING=off
