---
import { etatBoutiques, phraseAVenir } from "../lib/boutiques";
// Dedicated mobile-app page (/app) — presents the Jawdi mobile app with a coded
// phone hero, highlights, real screenshots and store CTAs.
import Base from "../layouts/Base.astro";
import StoreLinks from "../components/StoreLinks.astro";
import Highlight from "../components/Highlight.astro";
import Screenshot from "../components/Screenshot.astro";
import FinalCta from "../components/FinalCta.astro";
import { Image } from "astro:assets";
import mobileHome from "../assets/screens/mobile-home.png";
import mobileAnalytics from "../assets/screens/mobile-analytics.png";
import mobileTeam from "../assets/screens/mobile-team.png";
import iaDiagnostic from "../assets/screens/ia-mobile-diagnostic.png";

const signupUrl = import.meta.env.PUBLIC_APP_SIGNUP_URL || "#";
const boutiques = etatBoutiques(import.meta.env);
const aVenir = phraseAVenir(boutiques);
// L'encart d'installation n'a de sens que quand le fichier existe vraiment, et seulement tant
// qu'Android passe par le téléchargement direct : depuis le Play Store, il n'y a rien à expliquer.
const apkDirect = Boolean(boutiques.androidApk) && !boutiques.playStore;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jawdi.app";

const title = "L'app Jawdi — toute votre ferme dans votre poche";
const description =
  "L'application mobile Jawdi : saisie en 3 secondes même au poulailler, mode hors-ligne, dictée à Jawdi IA et synchronisation automatique. Suivez élevage, stocks, ventes et finances depuis votre téléphone.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Jawdi",
  applicationCategory: "BusinessApplication",
  operatingSystem: "iOS, Android",
  description,
  url: `${siteUrl}/app`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "XOF" },
};

const highlights = [
  { t: "Saisie en 3 secondes", b: "Mortalité, pesée, collecte, vente — les gestes du jour, sans friction." },
  { t: "Marche hors-ligne", b: "Le réseau coupe ? Vous continuez. Tout se synchronise dès qu'il revient." },
  { t: "Dictez à Jawdi IA", b: "Parlez, l'IA prépare la saisie et vous confirmez d'un geste." },
  { t: "Adapté à chaque rôle", b: "Propriétaire, gestionnaire, véto, éleveur : chacun voit ce qui le concerne." },
];

const rows = [
  {
    e: "Tableau de bord",
    t: "Votre ferme en un coup d'œil.",
    b: "Ventes de la période, effectif vivant, mortalité, taux de ponte — l'essentiel dès l'ouverture, avec les actions rapides à portée de pouce.",
    src: mobileHome,
  },
  {
    e: "Finances",
    t: "Savez enfin si vous gagnez.",
    b: "Marge cumulée, revenus vs dépenses, détail du chiffre d'affaires : la rentabilité de la ferme, claire, dans votre poche.",
    src: mobileAnalytics,
  },
  {
    e: "Équipe",
    t: "Toute l'équipe, au même endroit.",
    b: "Propriétaire, gestionnaire, vétérinaire, éleveur — les bons accès pour les bonnes personnes, sur chaque ferme.",
    src: mobileTeam,
  },
  {
    e: "Jawdi IA",
    t: "Un conseiller, même au poulailler.",
    b: "Demandez « comment va mon élevage ? » à la voix : Jawdi répond avec vos vrais chiffres, alerte et conseille.",
    src: iaDiagnostic,
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="app-hero">
    <div class="glow g1"></div>
    <div class="glow g2"></div>
    <div class="wrap app-hero-grid">
      <div class="app-hero-copy">
        <div class="app-eyebrow">◆ App mobile · iOS &amp; Android</div>
        <h1>Toute votre ferme,<br /><Highlight>dans votre poche</Highlight>.</h1>
        <p class="app-sub">
          Saisissez sur le terrain, suivez vos marges, dictez à Jawdi IA. L'app Jawdi met votre
          élevage, vos stocks et vos ventes au bout des doigts — même sans réseau.
        </p>
        {aVenir && <p class="app-soon">{aVenir}</p>}
        <StoreLinks rowClass="app-btns" tone="onDark" altPlay />
        {
          apkDirect && (
            <details class="app-apk">
              <summary>Comment installer le fichier Android ?</summary>
              <ol>
                <li>Touchez « Android (APK) » : votre téléphone télécharge le fichier.</li>
                <li>
                  Ouvrez-le. Android affiche un avertissement, parce que l'application ne vient
                  pas du Play Store. Touchez <b>Paramètres</b>, puis autorisez cette source.
                </li>
                <li>Revenez en arrière et touchez <b>Installer</b>.</li>
              </ol>
              <p>
                Jawdi n'est pas encore sur le Play Store : cette version ne se met donc pas à jour
                toute seule. Nous vous enverrons le nouveau fichier à chaque version.
              </p>
            </details>
          )
        }
      </div>
      <div class="app-hero-phone" data-float>
        <div class="app-bz">
          <span class="app-bz-notch" aria-hidden="true"></span>
          <Image
            src={mobileHome}
            alt="Application mobile Jawdi — écran d'accueil"
            widths={[320, 520, 700]}
            sizes="280px"
            loading="eager"
            class="app-bz-img"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="panel reveal">
    <div class="app-hl">
      {
        highlights.map((h) => (
          <div class="app-hl-card">
            <h3>{h.t}</h3>
            <p>{h.b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="panel panel-stone reveal">
    {
      rows.map((r, i) => (
        <div class:list={["app-row", { rev: i % 2 === 1 }]}>
          <div class="app-row-text">
            <div class="eyebrow">{r.e}</div>
            <h2>{r.t}</h2>
            <p>{r.b}</p>
          </div>
          <div class="app-row-visual">
            <Screenshot src={r.src} device="phone" alt={r.t} />
          </div>
        </div>
      ))
    }
  </section>

  <FinalCta
    title="Installez Jawdi sur votre téléphone."
    description="Gratuit pendant le pilote. Sans carte bancaire. En français."
  />
</Base>

<style is:global>
  .app-hero {
    position: relative;
    overflow: hidden;
    margin-top: -92px;
    padding: 176px 0 90px;
    color: #eaf3e4;
    background:
      radial-gradient(120% 80% at 78% -10%, rgba(61, 139, 61, 0.4), transparent 55%),
      linear-gradient(165deg, var(--earth) 0%, var(--earth-800) 60%, #0c220c 100%);
  }
  .app-hero .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    animation: appGlow 10s ease-in-out infinite;
  }
  .app-hero .g1 {
    width: 460px;
    height: 460px;
    top: -150px;
    right: -60px;
    background: radial-gradient(circle, rgba(61, 139, 61, 0.5), transparent 68%);
  }
  .app-hero .g2 {
    width: 500px;
    height: 500px;
    bottom: -220px;
    left: -140px;
    background: radial-gradient(circle, rgba(248, 150, 30, 0.26), transparent 66%);
    animation-duration: 12s;
  }
  .app-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }
  .app-eyebrow {
    display: inline-block;
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--leaf-300);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .app-hero h1 {
    color: #fff;
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    margin-top: 18px;
  }
  .app-sub {
    margin-top: 22px;
    font-size: 1.12rem;
    color: #cfe3c6;
    max-width: 46ch;
  }
  .app-soon {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: #a9c6a0;
  }
  /* Encart d'installation Android : posé sous les pastilles, replié par défaut —
     il ne concerne que les visiteurs Android et ne doit pas peser sur la page. */
  .app-apk {
    margin-top: 18px;
    max-width: 46ch;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.04);
    color: #d6e6d0;
    font-size: 14px;
    line-height: 1.55;
  }
  .app-apk summary {
    cursor: pointer;
    font-weight: 600;
    color: #fff;
  }
  .app-apk ol {
    margin: 12px 0 0;
    padding-left: 20px;
  }
  .app-apk li + li {
    margin-top: 6px;
  }
  .app-apk p {
    margin: 12px 0 0;
    color: #a9c6a0;
    font-size: 13px;
  }
  .app-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .app-hero-phone {
    display: flex;
    justify-content: center;
  }
  /* Same treatment as the homepage App section phone. */
  .app-bz {
    position: relative;
    width: 264px;
    background: #14110f;
    border-radius: 34px;
    padding: 8px;
    transform: rotate(6deg);
    box-shadow:
      0 50px 90px -34px rgba(0, 0, 0, 0.6),
      0 16px 32px -16px rgba(0, 0, 0, 0.42);
  }
  .app-bz-notch {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 84px;
    height: 18px;
    border-radius: 999px;
    background: #14110f;
    z-index: 2;
  }
  .app-bz-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 28px;
  }
  [data-float] {
    animation: appFloat 7s ease-in-out 0.6s infinite;
  }

  .app-hl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .app-hl-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
  }
  .app-hl-card h3 {
    font-size: 1.12rem;
  }
  .app-hl-card p {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .app-row {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 44px;
    align-items: center;
  }
  .app-row + .app-row {
    margin-top: 60px;
  }
  .app-row.rev .app-row-text {
    order: 2;
  }
  .app-row.rev .app-row-visual {
    order: 1;
  }
  .app-row-text h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 8px;
  }
  .app-row-text p {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 1.04rem;
  }

  @keyframes appFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @keyframes appGlow {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-float],
    .app-hero .glow {
      animation: none;
    }
  }

  @media (max-width: 920px) {
    .app-hero {
      margin-top: -86px;
      padding: 116px 0 64px;
    }
    .app-hero-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .app-hero-phone {
      order: -1;
    }
    .app-hl {
      grid-template-columns: 1fr 1fr;
    }
    .app-row,
    .app-row.rev {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .app-row.rev .app-row-text {
      order: 1;
    }
    .app-row.rev .app-row-visual {
      order: 2;
    }
  }
  @media (max-width: 560px) {
    .app-hl {
      grid-template-columns: 1fr;
    }
  }
</style>
