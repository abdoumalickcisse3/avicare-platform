---
// Sous-page module (`/fonctionnalites/{slug}`) — gabarit commun aux 5
// modules, généré par getStaticPaths() depuis data/modules.ts (source
// unique). Le prototype de référence ne détaille que le hub
// (#p-fonctionnalites) ; il n'existe pas de sous-page "Integration
// Details" à porter verbatim. Le gabarit reprend donc les briques déjà
// approuvées ailleurs dans le prototype/le design system :
//   - .phero (pill + H1 + lead) — identique à celui du hub, sans le
//     double-CTA (une seule page = un seul CTA, apporté par FinalCta).
//   - blocs "capacité → bénéfice" alternés (zig-zag texte / visuel) — mise
//     en page nouvelle (pas de markup prototype pour ça), avec un visuel
//     décoratif (icône du module) en lieu de vraie capture produit :
//     conforme à doc 2026-07-14 § "Images à fournir" ("captures produit …
//     en attendant : placeholders … pour ne pas bloquer le build").
//   - encadré "Ce que ça vous évite" (3 puces) — nouveau, fond clair
//     (--leaf-050), donc hors du périmètre de l'audit contraste (texte
//     sombre sur fond clair).
import Base from "../../layouts/Base.astro";
import FinalCta from "../../components/FinalCta.astro";
import { MODULES, type Module } from "../../data/modules";

export async function getStaticPaths() {
  return MODULES.map((m) => ({ params: { module: m.slug }, props: { module: m } }));
}

type Props = { module: Module };
const { module: mod } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://avicare.app";

// Icônes copiées verbatim des cartes `.mod` du prototype — même tracé que
// sur la grille du hub, réutilisé ici comme visuel décoratif des blocs
// capacité (aria-hidden, purement illustratif).
const icons: Record<string, string> = {
  elevage:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20c0-4 3-7 7-7 1.5 0 2.8.5 3.8 1.3"/><path d="M14 8a3 3 0 1 0-.1 0Z"/><path d="M17 6c2 0 3 1.5 3 3.5 0 3-2.4 5.5-6 5.5"/></svg>',
  sanitaire:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4.8 12.5 9 8.3a3 3 0 0 1 4.2 0l1.5 1.5"/><path d="m14 4 6 6"/><path d="m18 8-8.5 8.5a3 3 0 0 1-4.2 0 3 3 0 0 1 0-4.2Z"/></svg>',
  stocks:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 12v9"/><path d="m3 7 9-4 9 4v10l-9 4-9-4Z"/></svg>',
  ventes:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 4 6v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6l-2-4Z"/><path d="M4 6h16"/><path d="M8 10a4 4 0 0 0 8 0"/></svg>',
  finance:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 15 3-4 3 2 5-7"/></svg>',
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Fonctionnalités", item: `${siteUrl}/fonctionnalites` },
    { "@type": "ListItem", position: 3, name: mod.name, item: `${siteUrl}/fonctionnalites/${mod.slug}` },
  ],
};
---

<Base title={mod.seo.title} description={mod.seo.description} jsonLd={jsonLd}>
  <section class="phero">
    <div class="inner">
      <span class="pill">{mod.name}</span>
      <h1>{mod.h1}</h1>
      <p class="sub">{mod.lead}</p>
    </div>
  </section>

  <section class="panel reveal">
    <div class="caps">
      {
        mod.capabilities.map((cap, i) => (
          <div class:list={["cap", { rev: i % 2 === 1 }]}>
            <div class="cap-text">
              <div class="eyebrow">Capacité {String(i + 1).padStart(2, "0")}</div>
              <h3>{cap.title}</h3>
              <p>{cap.body}</p>
            </div>
            <div class="cap-visual" role="img" aria-label={`Aperçu de l'écran ${cap.title} dans AviCare`}>
              <span class="cap-ic" set:html={icons[mod.slug]} />
            </div>
          </div>
        ))
      }
    </div>

    <div class="avoid-box">
      <div class="eyebrow">Ce que ça vous évite</div>
      <ul>
        {
          mod.avoids.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FinalCta
    title="Essayez sur votre prochaine bande."
    description="Tous les modules, gratuits pendant le pilote. Sans carte bancaire."
  />
</Base>

<style is:global>
  .caps {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .cap {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .cap.rev {
    grid-template-columns: 0.9fr 1.1fr;
  }
  .cap .cap-text {
    order: 1;
  }
  .cap .cap-visual {
    order: 2;
  }
  .cap.rev .cap-text {
    order: 2;
  }
  .cap.rev .cap-visual {
    order: 1;
  }
  .cap-text h3 {
    font-size: 1.5rem;
    margin-top: 10px;
  }
  .cap-text p {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
  .cap-visual {
    aspect-ratio: 4 / 3;
    border-radius: 22px;
    background: linear-gradient(135deg, var(--leaf-050), var(--paper));
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
  }
  .cap-visual .cap-ic {
    width: 56px;
    height: 56px;
    color: var(--leaf);
    display: grid;
    place-items: center;
  }
  .cap-visual .cap-ic svg {
    width: 100%;
    height: 100%;
  }

  .avoid-box {
    background: var(--leaf-050);
    border: 1px solid var(--leaf-100);
    border-radius: 22px;
    padding: 32px;
    margin-top: 64px;
  }
  .avoid-box ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .avoid-box li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 1rem;
    color: var(--ink);
  }
  .avoid-box li svg {
    width: 18px;
    height: 18px;
    color: var(--leaf);
    flex: none;
    margin-top: 3px;
  }

  @media (max-width: 920px) {
    .caps {
      gap: 40px;
    }
    .cap,
    .cap.rev {
      grid-template-columns: 1fr;
    }
    .cap .cap-text,
    .cap.rev .cap-text {
      order: 1;
    }
    .cap .cap-visual,
    .cap.rev .cap-visual {
      order: 2;
    }
  }
</style>
