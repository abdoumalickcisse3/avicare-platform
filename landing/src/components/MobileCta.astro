---
const signupUrl = import.meta.env.PUBLIC_APP_SIGNUP_URL || "#";
---

<div class="mcta">
  <a class="btn btn-cta" href={signupUrl}>Commencer gratuitement</a>
</div>

<style>
  .mcta {
    display: none;
  }
  @media (max-width: 920px) {
    .mcta {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      padding: 12px 16px;
      background: rgba(246, 245, 242, 0.95);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
    }
    .mcta :global(.btn) {
      width: 100%;
      justify-content: center;
      padding: 15px;
    }
  }
</style>
