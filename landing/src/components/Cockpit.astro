---
// Aperçu produit flottant du hero — 4 KPI + sparkline SVG. Ported
// verbatim from the prototype's `.cockpit` block. Rendered inside the
// `.cluster` wrapper by Hero.astro, alongside the two floating `.chip`
// callouts.
import Kpi from "./Kpi.astro";
---

<div class="cockpit" aria-label="Aperçu du tableau de bord AviCare">
  <div class="cockpit-top">
    <span class="t">Bande · Poulailler Nord</span>
    <span class="live">EN DIRECT</span>
  </div>
  <div class="kpis">
    <div class="kpi">
      <div class="lab">Effectif total</div>
      <div class="val"><Kpi count={4870} /></div>
      <div class="trend">▲ Jour 22 / 45</div>
    </div>
    <div class="kpi down">
      <div class="lab">Taux de mortalité</div>
      <div class="val"><Kpi count={3.2} dec={1} suffix="%" /></div>
      <div class="trend">▼ sous le seuil 5%</div>
    </div>
    <div class="kpi hl-k">
      <div class="lab">Revenu du lot</div>
      <div class="val"><small>F </small><Kpi count={612} /><small> k</small></div>
      <div class="trend" style="color:var(--sun-600)">▲ +18% vs J-1</div>
    </div>
    <div class="kpi">
      <div class="lab">Indice de consommation</div>
      <div class="val"><Kpi count={1.85} dec={2} /></div>
      <div class="trend">aliment maîtrisé</div>
    </div>
    <div class="spark">
      <div class="lab"><span>Croissance du poids moyen (g)</span><span>J1 → J22</span></div>
      <svg viewBox="0 0 320 42" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="cockpitSpark" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3D8B3D" stop-opacity=".28"></stop>
            <stop offset="1" stop-color="#3D8B3D" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path
          d="M0,40 C40,38 60,31 90,27 C130,22 150,13 200,10 C250,7 280,5 320,3 L320,42 L0,42 Z"
          fill="url(#cockpitSpark)"></path>
        <path
          d="M0,40 C40,38 60,31 90,27 C130,22 150,13 200,10 C250,7 280,5 320,3"
          fill="none"
          stroke="#3D8B3D"
          stroke-width="2"></path>
        <circle cx="318" cy="3" r="3.5" fill="#F8961E"></circle>
      </svg>
    </div>
  </div>
</div>

<style is:global>
  .cockpit {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 30px 60px -28px rgba(41, 37, 36, 0.35);
  }
  .cockpit-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .cockpit-top .t {
    font-weight: 700;
    font-size: 14.5px;
  }
  .live {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--earth-700);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .live::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 0 rgba(61, 139, 61, 0.5);
    animation: cockpitPulse 2s infinite;
  }
  @keyframes cockpitPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(61, 139, 61, 0.45);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(61, 139, 61, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 139, 61, 0);
    }
  }
  .kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 11px;
  }
  .kpi {
    background: var(--stone);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 13px 14px;
  }
  .kpi.hl-k {
    background: linear-gradient(180deg, #fff7ec, #ffefd9);
    border-color: #ffddb0;
  }
  .kpi .lab {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .kpi .val {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1.5rem;
    margin-top: 5px;
    font-variant-numeric: tabular-nums;
  }
  .kpi.hl-k .val {
    color: var(--sun-600);
  }
  .kpi .val small {
    font-size: 0.5em;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .kpi .trend {
    font-family: var(--mono);
    font-size: 10.5px;
    margin-top: 2px;
    color: var(--earth-700);
  }
  .kpi.down .trend {
    color: #b45309;
  }
  .spark {
    grid-column: 1 / -1;
    background: var(--stone);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 11px 13px;
  }
  .spark .lab {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 7px;
  }
  .spark svg {
    display: block;
    width: 100%;
    height: 42px;
  }
</style>
