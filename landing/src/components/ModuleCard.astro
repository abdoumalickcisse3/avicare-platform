---
// Carte module de la grille "5 modules, un seul flux" (`.mod`), portée
// verbatim du prototype (docs/superpowers/specs/assets/landing-prototype.html,
// lignes 678-696 — commentaire prototype "module grid (Integration ref)").
// L'icône passe par un slot nommé (markup SVG brut), comme FeatureCard.
// Le module "featured" (Élevage) reçoit la variante `.feat-mod` (bouton
// plein, fond `--earth-800`). Le lien pointe vers la sous-page dédiée.
export interface Props {
  name: string;
  tag: string;
  teaser: string;
  slug: string;
  featured?: boolean;
}

const { name, tag, teaser, slug, featured = false } = Astro.props;
---

<div class:list={["mod", { "feat-mod": featured }]}>
  <div class="h">
    <span class="ic"><slot name="icon" /></span>
    <span class="nm">{name}<span>{tag}</span></span>
  </div>
  <p>{teaser}</p>
  <div class="sep"></div>
  <a class="go" href={`/fonctionnalites/${slug}`}>Découvrir le module <span>›</span></a>
</div>

<style is:global>
  .mod {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.18s,
      box-shadow 0.18s,
      border-color 0.18s;
  }
  .mod:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 34px -22px rgba(41, 37, 36, 0.35);
    border-color: var(--leaf-300);
  }
  .mod .h {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .mod .ic {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--leaf-050);
    color: var(--leaf);
    display: grid;
    place-items: center;
    flex: none;
  }
  .mod .ic svg {
    width: 20px;
    height: 20px;
  }
  .mod .nm {
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.2;
  }
  .mod .nm span {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 3px;
  }
  .mod p {
    color: var(--ink-soft);
    font-size: 14.5px;
    margin-top: 14px;
    flex: 1;
  }
  .mod .sep {
    border-top: 1px dashed var(--line);
    margin: 16px 0 14px;
  }
  .mod .go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 15px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--earth-700);
  }
  .mod .go:hover {
    border-color: var(--leaf);
    color: var(--leaf);
  }
  .mod.feat-mod .go {
    background: var(--earth-800);
    border-color: var(--earth-800);
    color: #fff;
  }
  .mod.feat-mod .go:hover {
    background: var(--earth);
  }
</style>
