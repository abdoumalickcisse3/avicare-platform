---
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-compact-white.svg";
import { RESEAUX_ACTIFS } from "../lib/reseaux";
import ReseauIcone from "./ReseauIcone.astro";

const partnerEmail = import.meta.env.PUBLIC_PARTNER_EMAIL || "contact@jawdi.app";
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <a href="/" aria-label="Jawdi Platform — accueil">
          <Image src={logoWhite} alt="Jawdi Platform" width={500} height={178} class="logo-d" />
        </a>
        <p class="about">
          La gestion d'élevage avicole pensée pour l'Afrique de l'Ouest — du poussin à la marge.
        </p>
        {
          RESEAUX_ACTIFS.length > 0 && (
            <ul class="socials" aria-label="Jawdi sur les réseaux sociaux">
              {RESEAUX_ACTIFS.map((r) => (
                <li>
                  <a
                    href={r.url}
                    target="_blank"
                    rel="me noopener"
                    aria-label={`Jawdi sur ${r.nom}`}
                    title={r.nom}
                  >
                    <ReseauIcone cle={r.cle} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="fcol">
        <h3>Produit</h3>
        <a href="/fonctionnalites">Fonctionnalités</a>
        <a href="/partenaires">Partenaires</a>
        <a href={import.meta.env.PUBLIC_APP_LOGIN_URL || "#"}>Se connecter</a>
      </div>
      <div class="fcol">
        <h3>Entreprise</h3>
        <a href="/a-propos">À propos</a>
        <a href="/contact">Contact</a>
        <a href="/ressources">Ressources</a>
      </div>
      <div class="fcol">
        <h3>Légal</h3>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
      </div>
    </div>
    <div class="fbot">
      <span>© {year} Jawdi Platform · Dakar, Sénégal</span>
      <span>{partnerEmail}</span>
    </div>
  </div>
</footer>

<style>
  /* Rangée d'icônes sociales. Discrète : le pied de page sert d'abord à
     naviguer, les réseaux sont une sortie, pas une destination. */
  .socials {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.85);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .socials a:hover,
  .socials a:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.45);
    color: #fff;
  }

  footer {
    background: var(--earth);
    color: #b7cbb0;
    padding: 56px 0 30px;
    margin-top: 0;
  }
  .fgrid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 32px;
  }
  /* Idem header : hauteur pilotée, largeur libre. Le footer n'a pas de
     contrainte de hauteur, le logo peut donc respirer davantage. */
  :global(.logo-d) {
    height: 80px;
    width: auto;
    display: block;
  }
  footer .about {
    margin-top: 14px;
    font-size: 13.5px;
    color: #8fa588;
    max-width: 34ch;
  }
  .fcol h3 {
    color: #eaf3e4;
    font-size: 12px;
    font-family: var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .fcol a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: #b7cbb0;
    font-size: 14px;
    padding: 5px 0;
  }
  .fcol a:hover {
    color: #fff;
  }
  .fbot {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 36px;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12.5px;
    color: #8fa588;
    font-family: var(--mono);
  }

  @media (max-width: 920px) {
    .fgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
