---
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-compact-white.svg";
import { RESEAUX_ACTIFS } from "../lib/reseaux";

const partnerEmail = import.meta.env.PUBLIC_PARTNER_EMAIL || "contact@jawdi.app";
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <a href="/" aria-label="Jawdi Platform — accueil">
          <Image src={logoWhite} alt="Jawdi Platform" width={500} height={178} class="logo-d" />
        </a>
        <p class="about">
          La gestion d'élevage avicole pensée pour l'Afrique de l'Ouest — du poussin à la marge.
        </p>
        {
          RESEAUX_ACTIFS.length > 0 && (
            <ul class="socials" aria-label="Jawdi sur les réseaux sociaux">
              {RESEAUX_ACTIFS.map((r) => (
                <li>
                  <a
                    href={r.url}
                    target="_blank"
                    rel="me noopener"
                    aria-label={`Jawdi sur ${r.nom}`}
                    title={r.nom}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      {r.cle === "linkedin" && (
                        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.6c0-1.34-.02-3.07-1.9-3.07-1.9 0-2.19 1.46-2.19 2.97V21h-4V9Z" />
                      )}
                      {r.cle === "facebook" && (
                        <path d="M14 9h3V5.5h-2.6C11.6 5.5 10 7.2 10 9.7V11H7.5v3.5H10V22h4v-7.5h2.6l.4-3.5H14V9.9c0-.6.3-.9 1-.9Z" />
                      )}
                      {r.cle === "instagram" && (
                        <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.68.8.9 1.4.17.4.36 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 1.8-.42 2.2a3.9 3.9 0 0 1-.9 1.4c-.4.4-.8.68-1.4.9-.4.17-1 .36-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.42a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.9-1.4c-.17-.4-.36-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-1.8.42-2.2.22-.6.5-1 .9-1.4.4-.42.8-.68 1.4-.9.4-.17 1-.36 2.2-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2a6.6 6.6 0 1 0 0 13.2 6.6 6.6 0 0 0 0-13.2Zm0 10.9a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6Zm6.9-11.2a1.55 1.55 0 1 1-3.1 0 1.55 1.55 0 0 1 3.1 0Z" />
                      )}
                      {r.cle === "whatsapp" && (
                        <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 5-1.3A10 10 0 1 0 12 2Zm5.8 14.1c-.25.7-1.45 1.33-2 1.4-.53.07-1.2.1-1.93-.12a16 16 0 0 1-1.75-.65c-3.08-1.33-5.09-4.43-5.24-4.64-.15-.2-1.25-1.66-1.25-3.17s.8-2.25 1.08-2.56c.28-.3.6-.38.8-.38h.58c.18 0 .43-.07.68.52l.93 2.26c.07.15.12.33.02.53l-.38.57-.28.3c-.1.1-.2.21-.08.41.12.2.53.88 1.14 1.42.78.7 1.44.92 1.64 1.02.2.1.33.08.45-.05l.65-.75c.15-.2.3-.17.5-.1l1.4.66c.2.1.35.15.4.23.05.1.05.56-.2 1.1Z" />
                      )}
                      {r.cle === "youtube" && (
                        <path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z" />
                      )}
                      {r.cle === "tiktok" && (
                        <path d="M16.6 5.8a4.8 4.8 0 0 1-1.2-3.1h-3.1v12.5a2.6 2.6 0 1 1-1.9-2.5v-3.2a5.8 5.8 0 1 0 5 5.7V9.4a7.8 7.8 0 0 0 4.4 1.4V7.7a4.8 4.8 0 0 1-3.2-1.9Z" />
                      )}
                      {r.cle === "x" && (
                        <path d="M17.5 3h3l-6.6 7.5L21.8 21h-5.9l-4.6-6-5.3 6H3l7-8L2.6 3h6l4.2 5.5L17.5 3Zm-1 16h1.6L7.6 4.7H5.9L16.5 19Z" />
                      )}
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="fcol">
        <h3>Produit</h3>
        <a href="/fonctionnalites">Fonctionnalités</a>
        <a href="/partenaires">Partenaires</a>
        <a href={import.meta.env.PUBLIC_APP_LOGIN_URL || "#"}>Se connecter</a>
      </div>
      <div class="fcol">
        <h3>Entreprise</h3>
        <a href="/a-propos">À propos</a>
        <a href="/contact">Contact</a>
        <a href="/ressources">Ressources</a>
      </div>
      <div class="fcol">
        <h3>Légal</h3>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
      </div>
    </div>
    <div class="fbot">
      <span>© {year} Jawdi Platform · Dakar, Sénégal</span>
      <span>{partnerEmail}</span>
    </div>
  </div>
</footer>

<style>
  /* Rangée d'icônes sociales. Discrète : le pied de page sert d'abord à
     naviguer, les réseaux sont une sortie, pas une destination. */
  .socials {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.85);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .socials a:hover,
  .socials a:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.45);
    color: #fff;
  }

  footer {
    background: var(--earth);
    color: #b7cbb0;
    padding: 56px 0 30px;
    margin-top: 0;
  }
  .fgrid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 32px;
  }
  /* Idem header : hauteur pilotée, largeur libre. Le footer n'a pas de
     contrainte de hauteur, le logo peut donc respirer davantage. */
  :global(.logo-d) {
    height: 80px;
    width: auto;
    display: block;
  }
  footer .about {
    margin-top: 14px;
    font-size: 13.5px;
    color: #8fa588;
    max-width: 34ch;
  }
  .fcol h3 {
    color: #eaf3e4;
    font-size: 12px;
    font-family: var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .fcol a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: #b7cbb0;
    font-size: 14px;
    padding: 5px 0;
  }
  .fcol a:hover {
    color: #fff;
  }
  .fbot {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 36px;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12.5px;
    color: #8fa588;
    font-family: var(--mono);
  }

  @media (max-width: 920px) {
    .fgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
