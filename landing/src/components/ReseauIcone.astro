---
/**
 * Le glyphe d'un réseau social, en un seul endroit.
 *
 * Le pied de page et le portail `/liens` affichent les mêmes comptes ; sans ce
 * composant, les deux porteraient leur propre copie des tracés, et le jour où
 * un réseau change de logo l'une des deux resterait en arrière.
 *
 * Les tracés sont redessinés à partir des marques officielles, dans une grille
 * 24×24 commune : ce sont des repères de reconnaissance, pas les logos
 * déposés eux-mêmes, et ils héritent de `currentColor` pour se poser sur
 * n'importe quel fond.
 */
import type { Reseau } from "../lib/reseaux";

export interface Props {
  cle: Reseau["cle"];
  taille?: number;
}

const { cle, taille = 18 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={taille} height={taille} fill="currentColor" aria-hidden="true">
  {
    cle === "linkedin" && (
      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.6c0-1.34-.02-3.07-1.9-3.07-1.9 0-2.19 1.46-2.19 2.97V21h-4V9Z" />
    )
  }
  {
