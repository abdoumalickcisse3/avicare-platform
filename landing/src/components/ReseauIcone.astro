---
/**
 * Le glyphe d'un réseau social, en un seul endroit.
 *
 * Les tracés étaient d'abord redessinés à la main dans ce fichier. Ils viennent
 * maintenant de **Simple Icons**, via `astro-icon` : ce sont les marques
 * officielles, tenues à jour par le jeu d'icônes, et plus par nous. Le SVG est
 * inliné à la construction — aucun appel réseau au runtime, et seuls les
 * glyphes réellement employés entrent dans la page.
 *
 * `currentColor` est conservé : une pastille claire sur fond sombre et un pied
 * de page vert foncé prennent le même composant.
 */
import { Icon } from "astro-icon/components";
import type { Reseau } from "../lib/reseaux";

export interface Props {
  cle: Reseau["cle"];
  taille?: number;
}

const { cle, taille = 18 } = Astro.props;

/** Clé du réseau → nom de l'icône dans Simple Icons. */
const GLYPHES: Record<Reseau["cle"], string> = {
  linkedin: "simple-icons:linkedin",
  facebook: "simple-icons:facebook",
  instagram: "simple-icons:instagram",
  whatsapp: "simple-icons:whatsapp",
  youtube: "simple-icons:youtube",
  tiktok: "simple-icons:tiktok",
  x: "simple-icons:x",
};
---

<Icon name={GLYPHES[cle]} width={taille} height={taille} aria-hidden="true" />
