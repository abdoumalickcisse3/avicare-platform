      <path d="M14 9h3V5.5h-2.6C11.6 5.5 10 7.2 10 9.7V11H7.5v3.5H10V22h4v-7.5h2.6l.4-3.5H14V9.9c0-.6.3-.9 1-.9Z" />
    )
  }
  {
    cle === "instagram" && (
