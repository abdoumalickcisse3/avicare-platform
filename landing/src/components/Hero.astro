---
// Hero de l'accueil — fond vert immersif + cluster produit (cockpit +
// chips flottantes) + bandeau de confiance. Ported verbatim from the
// prototype's `.hero` section (§ hero, § floating product cluster,
// § trust strip).
import Highlight from "./Highlight.astro";
import Cockpit from "./Cockpit.astro";
import TrustStrip from "./TrustStrip.astro";

const signupUrl = import.meta.env.PUBLIC_APP_SIGNUP_URL || "#";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Gestion d'élevage avicole · Afrique de l'Ouest</div>
      <h1 style="margin-top:16px">
        Votre élevage,<br />enfin <Highlight>sous contrôle</Highlight>.
      </h1>
      <p class="sub">
        De la bande à la marge : suivez vos poulets, vos coûts et vos ventes sur une seule
        plateforme pensée pour l'Afrique de l'Ouest — et sachez enfin si vous gagnez de l'argent.
      </p>
      <div class="hero-cta">
        <a class="btn btn-cta btn-lg" href={signupUrl}>Commencer gratuitement</a>
        <a class="btn btn-onearth btn-lg" href="#comment">Voir comment ça marche</a>
      </div>
      <div class="microproof">
        <span class="dot"></span>Gratuit pendant le pilote · Sans carte bancaire · En français
      </div>
    </div>

    <div class="cluster">
      <Cockpit />
      <div class="chip c1">
        <span class="ic">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        <span class="tx">Vaccination faite<span>Newcastle · J21</span></span>
      </div>
      <div class="chip c2">
        <span class="ic">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>
          </svg>
        </span>
        <span class="tx">Aliment bas<span>Démarrage · 12 sacs</span></span>
      </div>
    </div>
  </div>

  <TrustStrip />
</section>

<style is:global>
  .hero {
    position: relative;
    overflow: hidden;
    color: #eaf3e4;
    margin-top: -92px;
    padding: 130px 0 76px;
    background:
      radial-gradient(140% 90% at 82% -10%, rgba(61, 139, 61, 0.5), transparent 55%),
      radial-gradient(120% 120% at 8% 120%, rgba(248, 150, 30, 0.13), transparent 50%),
      linear-gradient(165deg, var(--earth) 0%, var(--earth-800) 62%, #0e240e 100%);
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 100% 40px;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 72%);
    mask-image: linear-gradient(to bottom, #000, transparent 72%);
  }
  .hero .wrap,
  .hero .trust {
    position: relative;
    z-index: 1;
  }
  .hero .eyebrow {
    color: var(--leaf-300);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.3rem, 4.9vw, 3.7rem);
  }
  .hero .sub {
    margin-top: 22px;
    font-size: 1.12rem;
    color: var(--ink-soft);
    max-width: 36ch;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 52px;
    align-items: center;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .microproof {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    font-size: 13px;
    color: var(--ink-faint);
    font-family: var(--mono);
  }
  .microproof .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sun);
  }

  /* floating product cluster */
  .cluster {
    position: relative;
    padding: 10px 0;
  }
  .chip {
    position: absolute;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 10px 13px;
    box-shadow: 0 18px 36px -18px rgba(41, 37, 36, 0.45);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .chip .ic {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    flex: none;
  }
  .chip .tx {
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.25;
  }
  .chip .tx span {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    font-weight: 500;
  }
  .chip.c1 {
    top: -14px;
    left: -26px;
  }
  .chip.c1 .ic {
    background: var(--leaf-050);
    color: var(--leaf);
  }
  .chip.c2 {
    bottom: -16px;
    right: -20px;
  }
  .chip.c2 .ic {
    background: var(--sun-050);
    color: var(--sun-600);
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero {
      margin-top: -86px;
      padding: 112px 0 60px;
    }
    .chip {
      display: none;
    }
  }
</style>
