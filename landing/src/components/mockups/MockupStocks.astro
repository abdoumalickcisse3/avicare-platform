---
// Recréation HTML/CSS des formules d'aliment (pas une capture d'écran) —
// valeurs figées par docs/superpowers/specs/assets/landing-module-mockups.md
// §3. Noms de formule corrigés (le spec signale que la capture d'origine
// portait des noms de jeu de test, "Dem"/"finition" — nom propres ici).
// Le détail d'ingrédients (bas de carte) est volontairement non rattaché à
// une formule nommée : le spec l'introduit comme un renfort "optionnel"
// sans dire à quelle formule il appartient.
import Kpi from "../Kpi.astro";

const formulas = [
  { name: "Démarrage poulet chair – Cobb 500", tag: "Démarrage", cost: 45000, items: "3 ingrédients · 100 %" },
  { name: "Croissance poulet chair – Cobb 500", tag: "Croissance", cost: 42700, items: "3 ingrédients · 100 %" },
  { name: "Finition poulet chair – Cobb 500", tag: "Finition", cost: 40400, items: "3 ingrédients · 100 %" },
  { name: "Ponte pondeuse – Lohmann Brown", tag: "Ponte", cost: 42150, items: "4 ingrédients · 100 %" },
];

const breakdown = [
  { name: "Maïs", pct: 60 },
  { name: "Tourteau d'arachide", pct: 32 },
  { name: "Prémix ponte", pct: 8 },
];
---

<div class="mk-stocks cluster">
  <div class="mk-head">
    <div class="mk-title">Formules d'aliment</div>
    <div class="mk-sub">Composez vos rations et optimisez vos coûts de production.</div>
  </div>

  <ul class="mk-formulas">
    {
      formulas.map((f) => (
        <li>
          <div class="mk-f-top">
            <span class="mk-f-name">{f.name}</span>
            <span class="mk-f-tag">{f.tag}</span>
          </div>
          <div class="mk-f-bottom">
            <span class="mk-f-cost">
              <Kpi count={f.cost} /> <span class="mk-unit">F CFA / 100 kg</span>
            </span>
            <span class="mk-f-items">{f.items}</span>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mk-detail">
    <div class="mk-detail-title">Détail d'une formule</div>
    <div class="mk-bars">
      {
        breakdown.map((b) => (
          <div class="mk-bar-row">
            <span class="mk-bar-label">{b.name}</span>
            <div class="mk-bar-meter">
              <div class="mk-bar-track">
                <div class="mk-bar-fill draw" style={`--pct:${b.pct}%`} />
              </div>
              <span class="mk-bar-pct"><Kpi count={b.pct} suffix="%" /></span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .mk-stocks {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mk-stocks .mk-title {
    font-weight: 700;
    font-size: 15px;
  }
  .mk-stocks .mk-sub {
    margin-top: 3px;
    font-size: 12px;
    color: var(--ink-soft);
  }
  .mk-stocks .mk-formulas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mk-stocks .mk-formulas li {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 10px 12px;
  }
  .mk-f-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .mk-f-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }
  .mk-f-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--earth-700);
    background: var(--leaf-100);
    border-radius: 999px;
    padding: 2px 8px;
    flex: none;
    white-space: nowrap;
  }
  .mk-f-bottom {
    margin-top: 6px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .mk-f-cost {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--leaf);
  }
  .mk-unit {
    font-size: 0.62em;
    font-weight: 500;
    color: var(--ink-faint);
  }
  .mk-f-items {
    font-size: 11px;
    color: var(--ink-faint);
  }

  .mk-stocks .mk-detail {
    background: var(--stone);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
  }
  .mk-detail-title {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .mk-bar-row {
    margin-top: 8px;
  }
  .mk-bar-row:first-child {
    margin-top: 0;
  }
  .mk-bar-label {
    display: block;
    font-size: 10.5px;
    color: var(--ink-soft);
    margin-bottom: 4px;
  }
  .mk-bar-meter {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mk-bar-track {
    flex: 1;
    min-width: 0;
    background: var(--line-soft);
    border-radius: 999px;
    height: 8px;
    overflow: hidden;
  }
  .mk-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--leaf);
    width: 0;
    transition: width 1s ease;
  }
  .reveal.in .mk-bar-fill.draw {
    width: var(--pct);
  }
  .mk-bar-pct {
    flex: none;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--ink);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .mk-bar-fill {
      width: var(--pct);
      transition: none;
    }
  }
</style>
