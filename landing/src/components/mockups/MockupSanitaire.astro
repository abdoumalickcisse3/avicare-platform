---
// Recréation HTML/CSS du suivi sanitaire (pas une capture d'écran) —
// valeurs et libellés figés par
// docs/superpowers/specs/assets/landing-module-mockups.md §2, verbatim
// (seule capture jugée exploitable telle quelle par le spec).
import Kpi from "../Kpi.astro";

const tiles = [
  { label: "Vaccins en attente", value: 3, note: "Doses en retard", accent: "red" },
  { label: "Traitements actifs", value: 0, note: "Aucun", accent: "blue" },
  { label: "Délais d'attente", value: "—", note: "Aucun délai", accent: "orange" },
  { label: "Prochaine visite véto", value: "—", note: "Aucun suivi", accent: "green" },
];

const history = [
  { title: "Vaccin Newcastle Clone30 en retard", lot: "Lot Mbour", delay: "2 j de retard", date: "14 juil. 2026" },
  { title: "Vaccin Gumboro 228e en retard", lot: "Mbalo", delay: "3 j de retard", date: "13 juil. 2026" },
  { title: "Vaccin Gumboro D78 en retard", lot: "Lot Mbour", delay: "9 j de retard", date: "07 juil. 2026" },
];
---

<div class="mk-sanitaire cluster">
  <div class="mk-tiles">
    {
      tiles.map((t) => (
        <div class={`mk-tile mk-accent-${t.accent}`}>
          <div class="mk-tile-l">{t.label}</div>
          <div class="mk-tile-v">
            {typeof t.value === "number" ? <Kpi count={t.value} /> : t.value}
          </div>
          <div class="mk-tile-n">{t.note}</div>
        </div>
      ))
    }
  </div>

  <div class="mk-history">
    <div class="mk-history-title">Historique sanitaire récent</div>
    <ul>
      {
        history.map((h) => (
          <li>
            <div class="mk-h-main">
              <span class="mk-h-title">{h.title}</span>
              <span class="mk-h-date">{h.date}</span>
            </div>
            <div class="mk-h-meta">
              <span class="mk-h-lot">{h.lot}</span>
              <span class="mk-h-delay">{h.delay}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style is:global>
  .mk-sanitaire {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mk-sanitaire .mk-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mk-sanitaire .mk-tile {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 3px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .mk-sanitaire .mk-accent-red {
    border-left-color: #c94a3a;
  }
  .mk-sanitaire .mk-accent-blue {
    border-left-color: #2f6fb0;
  }
  .mk-sanitaire .mk-accent-orange {
    border-left-color: var(--sun-600);
  }
  .mk-sanitaire .mk-accent-green {
    border-left-color: var(--leaf);
  }
  .mk-sanitaire .mk-tile-l {
    font-size: 11px;
    color: var(--ink-soft);
  }
  .mk-sanitaire .mk-tile-v {
    margin-top: 3px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .mk-sanitaire .mk-tile-n {
    margin-top: 2px;
    font-size: 10.5px;
    color: var(--ink-faint);
  }

  .mk-sanitaire .mk-history {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px 14px;
  }
  .mk-sanitaire .mk-history-title {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .mk-sanitaire ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mk-sanitaire li {
    padding-top: 10px;
    border-top: 1px solid var(--line-soft);
  }
  .mk-sanitaire li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .mk-sanitaire .mk-h-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 10px;
  }
  .mk-sanitaire .mk-h-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    min-width: 0;
  }
  .mk-sanitaire .mk-h-date {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-faint);
    flex: none;
  }
  .mk-sanitaire .mk-h-meta {
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .mk-sanitaire .mk-h-lot {
    font-size: 11.5px;
    color: var(--ink-soft);
  }
  .mk-sanitaire .mk-h-delay {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    color: #a83a2c;
    background: #fbe9e6;
    border-radius: 999px;
    padding: 2px 8px;
  }

  @media (max-width: 400px) {
    .mk-sanitaire .mk-tile-v {
      font-size: 1.1rem;
    }
  }
</style>
