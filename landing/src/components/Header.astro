---
// Floating pill navigation — the one deliberately-floating rounded
// element on the site (client explicitly rejected floating panels for
// content sections; the nav island is the exception, per prototype).
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const signupUrl = import.meta.env.PUBLIC_APP_SIGNUP_URL || "#";

const navLinks = [
  { href: "/fonctionnalites", label: "Fonctionnalités" },
  { href: "/tarifs", label: "Tarifs" },
  { href: "/a-propos", label: "À propos" },
  { href: "/faq", label: "FAQ" },
];
---

<header>
  <div class="wrap nav">
    <a href="/" aria-label="AviCare Platform — accueil" class="logo-link">
      <Image src={logo} alt="AviCare Platform" width={150} height={38} class="logo-img" />
    </a>

    <nav class="nav-links" aria-label="Navigation principale">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="nav-right">
      <a class="nav-login" href={signupUrl}>Se connecter</a>
      <a class="btn btn-cta" href={signupUrl}>Commencer gratuitement</a>
      <button
        class="burger"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-menu-panel hidden>
    <nav aria-label="Navigation mobile">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={signupUrl}>Se connecter</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 14px 16px;
    background: transparent;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 10px 12px 10px 20px;
    height: 64px;
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    backdrop-filter: saturate(1.5) blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    box-shadow:
      0 14px 34px -16px rgba(18, 43, 18, 0.45),
      0 2px 6px -2px rgba(18, 43, 18, 0.12);
  }
  .logo-link {
    display: block;
    line-height: 0;
  }
  :global(.logo-img) {
    height: 38px;
    width: 150px;
    display: block;
    object-fit: contain;
    object-position: left center;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 15px;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .nav-links a:hover {
    color: var(--earth-700);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .nav-login {
    font-size: 15px;
    font-weight: 600;
    color: var(--earth-700);
  }
  .burger {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    color: var(--ink);
  }

  .mobile-nav {
    max-width: var(--wrap);
    margin: 8px auto 0;
    padding: 0 16px;
  }
  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    backdrop-filter: saturate(1.5) blur(14px);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 10px;
    box-shadow:
      0 14px 34px -16px rgba(18, 43, 18, 0.45),
      0 2px 6px -2px rgba(18, 43, 18, 0.12);
  }
  .mobile-nav a {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .mobile-nav a:hover {
    background: var(--stone);
    color: var(--earth-700);
  }

  @media (max-width: 920px) {
    .nav-links,
    .nav-login {
      display: none;
    }
    .burger {
      display: block;
    }
    .nav {
      padding: 8px 10px 8px 14px;
      height: 58px;
    }
  }
  @media (min-width: 921px) {
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  if (toggle && panel) {
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      if (panel.hidden) open();
      else close();
    });

    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).tagName === "A") close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });

    window.matchMedia("(min-width: 921px)").addEventListener("change", (e) => {
      if (e.matches) close();
    });
  }
</script>
