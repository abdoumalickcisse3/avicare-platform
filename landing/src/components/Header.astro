---
// Floating pill navigation — the one deliberately-floating rounded
// element on the site (client explicitly rejected floating panels for
// content sections; the nav island is the exception, per prototype).
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import logoLight from "../assets/logo-dark.svg";

// `solid` = header opaque (glass) dès le chargement, pour les pages dont le
// haut n'est PAS un hero sombre (ex. l'article Ressources, fond clair). Par
// défaut le header est transparent au sommet puis devient glass au scroll.
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;

const signupUrl = import.meta.env.PUBLIC_APP_SIGNUP_URL || "#";

const navLinks = [
  { href: "/fonctionnalites", label: "Fonctionnalités" },
  { href: "/tarifs", label: "Tarifs" },
  { href: "/a-propos", label: "À propos" },
  { href: "/faq", label: "FAQ" },
];
---

<header class:list={[{ solid }]} data-header>
  <div class="wrap nav">
    <a href="/" aria-label="Jawdi Platform — accueil" class="logo-link">
      {/* Deux logos permutés par CSS selon l'état du header : le logo clair
          (logo-dark) au sommet sur le hero sombre, le logo sombre une fois le
          fond glass posé. eager + priorité haute : au-dessus de la ligne de
          flottaison sur toutes les pages, lazy retarderait le LCP. */}
      <Image
        src={logoLight}
        alt="Jawdi Platform"
        width={150}
        height={52}
        class="logo-img logo-on-dark"
        loading="eager"
        fetchpriority="high"
      />
      <Image
        src={logo}
        alt="Jawdi Platform"
        width={150}
        height={52}
        class="logo-img logo-on-glass"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="nav-links" aria-label="Navigation principale">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="nav-right">
      <a class="nav-login" href={signupUrl}>Se connecter</a>
      <a class="btn btn-cta" href={signupUrl}>Commencer gratuitement</a>
      <button
        class="burger"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-menu-panel hidden>
    <nav aria-label="Navigation mobile">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={signupUrl}>Se connecter</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 14px 16px;
    background: transparent;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 10px 12px 10px 20px;
    height: 64px;
    border-radius: 999px;
    /* État sommet : transparent, posé sur le hero sombre. Le fond glass et
       l'ombre n'apparaissent qu'au scroll (header.scrolled) ou d'emblée sur
       les pages à fond clair (header.solid). Transition douce des deux. */
    background: transparent;
    border: 1px solid transparent;
    box-shadow: none;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  header.scrolled .nav,
  header.solid .nav {
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    backdrop-filter: saturate(1.5) blur(14px);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow:
      0 14px 34px -16px rgba(18, 43, 18, 0.45),
      0 2px 6px -2px rgba(18, 43, 18, 0.12);
  }
  /* Permutation des logos : clair au sommet, sombre sur le glass. Double
     classe (.logo-img.logo-*) pour battre la spécificité de `.logo-img`
     qui pose display:block. */
  :global(.logo-img.logo-on-glass) {
    display: none;
  }
  header.scrolled :global(.logo-img.logo-on-dark),
  header.solid :global(.logo-img.logo-on-dark) {
    display: none;
  }
  header.scrolled :global(.logo-img.logo-on-glass),
  header.solid :global(.logo-img.logo-on-glass) {
    display: block;
  }
  .logo-link {
    display: block;
    line-height: 0;
  }
  /* Hauteur pilotée, largeur libre : le ratio natif du logo (2.89:1) est ainsi
     respecté sans déformation ni vide à droite. L'îlot fait 64px de haut avec
     10px de padding vertical → 44px utiles ; 42px laisse une marge d'air. */
  :global(.logo-img) {
    height: 42px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 15px;
    /* Sommet : texte clair sur le hero sombre. */
    color: #cfe3c6;
    font-weight: 500;
    transition: color 0.25s ease;
  }
  header.scrolled .nav-links,
  header.solid .nav-links {
    color: var(--ink-soft);
  }
  .nav-links a:hover {
    color: #fff;
  }
  header.scrolled .nav-links a:hover,
  header.solid .nav-links a:hover {
    color: var(--earth-700);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .nav-login {
    font-size: 15px;
    font-weight: 600;
    /* Sommet : clair sur le hero sombre ; glass : vert foncé. */
    color: #eaf3e4;
    transition: color 0.25s ease;
  }
  header.scrolled .nav-login,
  header.solid .nav-login {
    color: var(--earth-700);
  }
  .burger {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    /* Sommet : clair sur le hero sombre ; glass : sombre. */
    color: #eaf3e4;
    transition: color 0.25s ease;
  }
  header.scrolled .burger,
  header.solid .burger {
    color: var(--ink);
  }

  .mobile-nav {
    max-width: var(--wrap);
    margin: 8px auto 0;
    padding: 0 16px;
  }
  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    backdrop-filter: saturate(1.5) blur(14px);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 10px;
    box-shadow:
      0 14px 34px -16px rgba(18, 43, 18, 0.45),
      0 2px 6px -2px rgba(18, 43, 18, 0.12);
  }
  .mobile-nav a {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .mobile-nav a:hover {
    background: var(--stone);
    color: var(--earth-700);
  }

  @media (max-width: 920px) {
    .nav-links,
    .nav-login,
    .nav-right .btn-cta {
      display: none;
    }
    .burger {
      display: block;
    }
    .nav {
      padding: 8px 10px 8px 14px;
      height: 58px;
    }
  }
  @media (min-width: 921px) {
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  // Header transparent au sommet → glass au scroll. `.solid` (pages à fond
  // clair) est figé glass et n'est jamais touché ici. Seuil 100px, via
  // requestAnimationFrame pour ne pas thrasher au scroll.
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header && !header.classList.contains("solid")) {
    let ticking = false;
    const sync = () => {
      header.classList.toggle("scrolled", window.scrollY > 100);
      ticking = false;
    };
    sync(); // état correct si la page charge déjà scrollée (ancre, refresh)
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true },
    );
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  if (toggle && panel) {
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      if (panel.hidden) open();
      else close();
    });

    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).tagName === "A") close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });

    window.matchMedia("(min-width: 921px)").addEventListener("change", (e) => {
      if (e.matches) close();
    });
  }
</script>
