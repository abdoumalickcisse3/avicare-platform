---
// Carte module de la section Solution (`.fcard`). Icône via un slot
// nommé (markup SVG brut, comme dans le prototype). `description`
// passe par set:html : la copy porte des espaces insécables et des
// esperluettes échappées (`&nbsp;`, `&amp;`) copiés verbatim du
// prototype.
//
// Le `.fcard` de base est déclaré is:global ici pour pouvoir aussi
// habiller la carte large "Tout est relié" (markup écrit directement
// dans index.astro, pas via ce composant) avec les mêmes règles —
// exactement comme dans le prototype, où tout vivait dans une seule
// feuille de style globale.
export interface Props {
  title: string;
  description: string;
  miniLabel: string;
  miniValue: string;
}

const { title, description, miniLabel, miniValue } = Astro.props;
---

<div class="fcard">
  <div class="ic"><slot name="icon" /></div>
  <h3>{title}</h3>
  <p set:html={description} />
  <div class="mini">
    <span>{miniLabel}</span><b>{miniValue}</b>
  </div>
</div>

<style is:global>
  .fcard {
    background: var(--stone);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      transform 0.18s,
      box-shadow 0.18s,
      border-color 0.18s;
  }
  .fcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 34px -22px rgba(41, 37, 36, 0.35);
    border-color: var(--leaf-300);
  }
  .fcard .ic {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--leaf-050);
    color: var(--leaf);
    display: grid;
    place-items: center;
  }
  .fcard .ic svg {
    width: 21px;
    height: 21px;
  }
  .fcard h3 {
    font-size: 1.1rem;
  }
  .fcard p {
    color: var(--ink-soft);
    font-size: 14.5px;
    flex: 1;
  }
  .fcard .mini {
    border-top: 1px dashed var(--line);
    padding-top: 11px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
  }
  .fcard .mini b {
    color: var(--leaf);
    font-weight: 600;
  }
  .fcard.wide {
    grid-column: span 3;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(120deg, var(--leaf-050), var(--paper));
    gap: 22px;
  }

  @media (max-width: 920px) {
    .fcard.wide {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
