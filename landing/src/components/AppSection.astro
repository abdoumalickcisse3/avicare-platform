---
// Homepage "App mobile" section (inspired by fitsen's app block): a light card
// with copy + store buttons on the left and a tilted coded phone on the right.
import Highlight from "./Highlight.astro";
import { Image } from "astro:assets";
import StoreLinks from "./StoreLinks.astro";
import mobileHome from "../assets/screens/mobile-home.png";

const appStoreUrl = import.meta.env.PUBLIC_APP_STORE_URL || "";
const playStoreUrl = import.meta.env.PUBLIC_PLAY_STORE_URL || "";
const storesLive = Boolean(appStoreUrl || playStoreUrl);
---

<section class="panel reveal">
  <div class="appsec">
    <div class="appsec-copy">
      <div class="appsec-eyebrow">◆ App mobile</div>
      <h2>Votre élevage, <Highlight>dans votre poche</Highlight>.</h2>
      <p>
        Saisissez en 3 secondes, même au poulailler : mortalité, pesée, collecte d'œufs, vente.
        Dictez à <strong>Jawdi IA</strong>, travaillez hors-ligne — tout se synchronise dès que le
        réseau revient.
      </p>
      {!storesLive && <p class="appsec-soon">Bientôt sur l'App Store et Google Play</p>}
      <StoreLinks rowClass="appsec-btns" />
    </div>

    <div class="appsec-phone">
      <div class="apbz">
        <span class="apbz-notch" aria-hidden="true"></span>
        <Image
          src={mobileHome}
          alt="Application mobile Jawdi — écran d'accueil : ventes, effectif, mortalité et actions rapides"
          widths={[300, 480, 640]}
          sizes="264px"
          loading="lazy"
          class="apbz-img"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .appsec {
    position: relative;
    max-width: var(--wrap);
    margin: 70px auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 44px 52px;
    box-shadow: 0 30px 70px -40px rgba(18, 43, 18, 0.28);
    /* Full width, short height: the copy defines the card height. The phone is
       positioned in the foreground and overflows the card top + bottom. */
    overflow: visible;
  }
  .appsec-copy {
    max-width: 56%;
  }
  .appsec-eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--earth-700);
    font-weight: 600;
  }
  .appsec-copy h2 {
    margin-top: 12px;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  }
  .appsec-copy p {
    margin-top: 16px;
    font-size: 1.08rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .appsec-copy p strong {
    color: var(--ink);
    font-weight: 700;
  }
  .appsec-soon {
    font-family: var(--mono);
    font-size: 12.5px !important;
    color: var(--ink-faint) !important;
    margin-top: 14px !important;
  }
  /* Phone: foreground, right side. Its BOTTOM sits inside the card (aligned
     with the store buttons); the top overflows above the card. */
  .appsec-phone {
    position: absolute;
    right: 52px;
    bottom: 34px;
    width: 208px;
    z-index: 2;
    transform: rotate(6deg);
  }
  .apbz {
    position: relative;
    background: #14110f;
    border-radius: 34px;
    padding: 8px;
    box-shadow:
      0 50px 90px -34px rgba(0, 0, 0, 0.5),
      0 16px 32px -16px rgba(0, 0, 0, 0.4);
  }
  .apbz-notch {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 84px;
    height: 18px;
    border-radius: 999px;
    background: #14110f;
    z-index: 2;
  }
  .apbz-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 28px;
  }

  @media (max-width: 860px) {
    .appsec {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 30px 24px 34px;
    }
    .appsec-copy {
      max-width: 100%;
      order: 2;
    }
    /* `:global()` : la rangée est rendue par StoreLinks, donc hors de la portée
       du style scopé de ce fichier. Seul ce réglage de mise en page reste ici,
       l'habillage des pastilles appartient au composant. */
    :global(.appsec-btns) {
      justify-content: center;
    }
    .appsec-copy p {
      margin-inline: auto;
    }
    /* On mobile the phone sits inline above the copy (no overflow). */
    .appsec-phone {
      position: static;
      transform: none;
      width: 230px;
      order: 1;
      margin-bottom: 22px;
    }
  }
</style>
