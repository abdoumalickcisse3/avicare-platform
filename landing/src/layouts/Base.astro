---
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCta from "../components/MobileCta.astro";
import CountUp from "../components/CountUp.astro";
import outfit600 from "../fonts/outfit-600.woff2";
import outfit700 from "../fonts/outfit-700.woff2";
import "../styles/tokens.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonical, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" as="font" type="font/woff2" href={outfit600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={outfit700} crossorigin />

    <SeoHead title={title} description={description} canonical={canonical} jsonLd={jsonLd} />

    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <CountUp />
  </body>
</html>
