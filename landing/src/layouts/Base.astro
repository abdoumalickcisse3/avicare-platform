---
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCta from "../components/MobileCta.astro";
import CountUp from "../components/CountUp.astro";
import outfit600 from "../fonts/outfit-600.woff2";
import outfit700 from "../fonts/outfit-700.woff2";
import "../styles/tokens.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
  image?: string;
  // Header opaque dès le chargement : pour les pages dont le haut n'est PAS
  // un hero sombre (l'article Ressources a un fond clair). Défaut : header
  // transparent au sommet puis glass au scroll.
  solidHeader?: boolean;
}

const { title, description, canonical, jsonLd, image, solidHeader = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preload" as="font" type="font/woff2" href={outfit600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={outfit700} crossorigin />

    <SeoHead title={title} description={description} canonical={canonical} jsonLd={jsonLd} image={image} />

    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Header solid={solidHeader} />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <CountUp />
  </body>
</html>
