# Landing (Astro vitrine) public config. Copy to landing/.env and fill for prod.
# The landing lives at the root domain; the web app (login/signup/dashboard)
# lives on the app subdomain — CTAs link across to it.

PUBLIC_SITE_URL=https://jawdi.com
PUBLIC_APP_SIGNUP_URL=https://app.jawdi.com/signup
PUBLIC_APP_LOGIN_URL=https://app.jawdi.com/login
PUBLIC_PARTNER_EMAIL=partenaires@jawdi.com
PUBLIC_CONTACT_PHONE=+221 XX XXX XX XX
