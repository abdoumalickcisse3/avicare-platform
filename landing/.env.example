# Landing (Astro vitrine) public config. Copy to landing/.env and fill for prod.
# The landing lives at the root domain; the web app (login/signup/dashboard)
# lives on the app subdomain — CTAs link across to it.

PUBLIC_SITE_URL=https://jawdi.app
# Phase collaborateurs : "Commencer gratuitement" mène à la page /contact
# (chemin relatif). Repointer sur https://app.jawdi.app/signup pour rouvrir
# l'inscription self-service.
PUBLIC_APP_SIGNUP_URL=/contact
PUBLIC_APP_LOGIN_URL=https://app.jawdi.app/login
# Coordonnées de l'équipe affichées sur /contact. Le numéro alimente aussi le
# lien wa.me du formulaire (chiffres uniquement, international sans "+").
PUBLIC_PARTNER_EMAIL=malick.cisse@nlogicsolutions.com
PUBLIC_CONTACT_PHONE=+221 70 475 69 96
